        "aura": "animation.raven_witch.aura",
        "rage_aura": "animation.raven_witch.rage_aura",
        "cast_hex": "animation.raven_witch.cast_hex",
        "cast_pumpkin": "animation.raven_witch.cast_pumpkin",
        "cast_raven": "animation.raven_witch.cast_raven",
        "cast_nova": "animation.raven_witch.cast_nova",
        "enrage": "animation.raven_witch.enrage"
      }
    }
